class TermuxAPI:
    @staticmethod
    def available(cmd): return shutil.which(cmd) is not None

    @staticmethod
    def speak(text):
        if TermuxAPI.available("termux-tts-speak"):
            try: subprocess.run(["termux-tts-speak", text[:1000]], timeout=15); return True
            except: return False
        return False

    @staticmethod
    def copy(text):
        if TermuxAPI.available("termux-clipboard-set"):
            try: subprocess.run(["termux-clipboard-set"], input=text, text=True, timeout=5); return True
            except: return False
        return False

    @staticmethod
    def paste():
        if TermuxAPI.available("termux-clipboard-get"):
            try:
                r = subprocess.run(["termux-clipboard-get"], capture_output=True, text=True, timeout=5)
                return r.stdout
            except: return None
        return None

    @staticmethod
    def share(text):
        if TermuxAPI.available("termux-share"):
            try: subprocess.run(["termux-share", "-a", "send"], input=text, text=True, timeout=10); return True
            except: return False
        return False

    @staticmethod
    def status():
        return {
            "tts": TermuxAPI.available("termux-tts-speak"),
            "clipboard": TermuxAPI.available("termux-clipboard-set"),
            "share": TermuxAPI.available("termux-share"),
        }

class ServerManager:
    @staticmethod
    def manage(action, engine="ollama"):
        if action == "start":
            if PID_FILE.exists(): print(f"{C.YELLOW}Server PID file already exists. Check status or stop it first.{C.RESET}"); return
            if engine == "ollama": cmd = ["ollama", "serve"]
            else: print(f"{C.RED}Invalid engine. Use 'ollama'.{C.RESET}"); return
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, preexec_fn=os.setsid)
                PID_FILE.write_text(f"{proc.pid},{engine}")
                print(f"{C.GREEN}Started {engine} server in background (PID: {proc.pid}).{C.RESET}")
            except Exception as e: print(f"{C.RED}Failed to start server: {e}{C.RESET}")
        elif action == "stop":
            if not PID_FILE.exists(): print(f"{C.YELLOW}No running server process found.{C.RESET}"); return
            try:
                content = PID_FILE.read_text().strip().split(",")
                pid, eng = int(content[0]), content[1]
                os.killpg(os.getpgid(pid), signal.SIGTERM)
                print(f"{C.GREEN}Stopped background {eng} server (PID: {pid}).{C.RESET}")
            except Exception as e: print(f"{C.RED}Error stopping server: {e}{C.RESET}")
            finally:
                if PID_FILE.exists(): PID_FILE.unlink()
        elif action == "status":
            if not PID_FILE.exists(): print(f"{C.YELLOW}Local server status: Stopped{C.RESET}"); return
            try:
                content = PID_FILE.read_text().strip().split(",")
                pid, eng = int(content[0]), content[1]
                os.kill(pid, 0)
                print(f"{C.GREEN}Local server status: Running ({eng}, PID: {pid}){C.RESET}")
            except OSError:
                print(f"{C.RED}Local server status: Dead. Cleaning PID file.{C.RESET}")
                PID_FILE.unlink()


