    def run_cmd(self, txt):
        p = txt.strip().split(maxsplit=1)
        cmd = p[0].lower()
        arg = p[1].strip() if len(p) > 1 else ""

        if cmd in ("/exit", "/quit"): sys.exit(0)
        elif cmd == "/help": print(self.HELP_TEXT)
        elif cmd == "/backend":
            if not arg: self.info(f"Active backend: {self.cfg.get('backend')}"); return True
            if arg not in self.cfg.get("backends", {}) and arg not in ("anthropic", "claude"):
                self.warn(f"'{arg}' not configured."); self.hint(f"/profile add {arg} <base_url> <model> [api_key]"); return True
            self.cfg.set("backend", arg)
            try: self.backend = get_backend(self.cfg); self.info(f"Switched to: {arg} ({self._current_model()})")
            except Exception as e: self.err(str(e))
        elif cmd == "/backends":
            backends = self.cfg.get("backends", {})
            if not backends: self.warn("No backends configured."); self.hint("/profile add <name> <base_url> <model> [api_key]"); return True
            print(f"\n  {C.BOLD}{'':2s}{'name':12s} {'model':24s} {'base_url'}{C.RESET}")
            print(f"  {C.DIM}{'─' * 70}{C.RESET}")
            for n, prof in backends.items():
                active = f"{C.GREEN}▶{C.RESET}" if n == self.cfg.get("backend") else " "
                m, u = prof.get("model", "?"), prof.get("base_url", "")
                print(f"  {active} {C.CYAN}{n:12s}{C.RESET} {m:24s} {C.DIM}{u}{C.RESET}")
        elif cmd == "/profile": self._cmd_profile(arg)
        elif cmd == "/model":
            if not arg: self.info(f"Model: {self._current_model()}"); return True
            name, _ = self.cfg.active_profile()
            target = "backends.anthropic.model" if name in ("anthropic", "claude") else f"backends.{name}.model"
            self.cfg.set_path(target, arg)
            try: self.backend = get_backend(self.cfg); self.info(f"Model → {arg}")
            except Exception as e: self.err(str(e))
        elif cmd == "/tools":
            if arg in ("on", "off"): self.cfg.set("tools_enabled", arg == "on")
            state = "build" if self.cfg.get("tools_enabled") else "plan"
            color = C.GREEN if state == "build" else C.YELLOW
            self.info(f"Tools: {color}{state}{C.RESET}")
            if state == "build": self.hint("AI can read/write files & run any shell commands")
            else: self.hint("AI can read files & run safe commands, but cannot write/modify")
        elif cmd == "/multi":
            if arg in ("on", "off"): self.cfg.set("multi_line", arg == "on"); self.multi_line = arg == "on"
            state = "on" if self.multi_line else "off"
            self.info(f"Multi-line: {state}")
            if self.multi_line: self.hint("End input with a blank line (or Ctrl-D) to send")
        elif cmd == "/system":
            if arg: self.cfg.set("system_prompt", arg); self.info("System prompt updated.")
            else: print(f"\n  {C.DIM}system prompt:{C.RESET}\n  {C.ITALIC}{self.cfg.system_prompt()}{C.RESET}\n")
        elif cmd == "/status": self._show_status()
        elif cmd == "/new":
            self.cid = None; self.last_reply = ""; self.info("Started a new conversation.")
        elif cmd == "/history": self._show_history()
        elif cmd == "/load":
            if not arg.isdigit(): self.warn("Usage: /load <id>"); return True
            cid = int(arg)
            conv = self.db.get_conv(cid)
            if not conv: self.err(f"Conversation #{cid} not found."); return True
            self.cid = cid; self.info(f"Loaded: {conv['title']}"); self._show_conversation(cid, limit=6)
        elif cmd == "/rename":
            if not self.cid: self.warn("No active conversation. Send a message first."); return True
            if not arg: self.warn("Usage: /rename <new title>"); return True
            self.db.rename_conv(self.cid, arg); self.info(f"Renamed to: {arg}")
        elif cmd == "/delete":
            cid = int(arg) if arg.isdigit() else self.cid
            if cid is None: self.warn("Usage: /delete [id]"); return True
            conv = self.db.get_conv(cid)
            if not conv: self.err(f"Conversation #{cid} not found."); return True
            try: confirm = input(f"  {C.YELLOW}Delete '#{cid}' '{conv['title']}'? [y/N] {C.RESET}").strip().lower()
            except: confirm = ""
            if confirm in ("y", "yes"):
                self.db.del_conv(cid)
                if self.cid == cid: self.cid = None
                self.info(f"Deleted #{cid}.")
            else: self.hint("Cancelled.")
        elif cmd == "/show":
            if not self.cid: self.warn("No active conversation."); return True
            self._show_conversation(self.cid, limit=50)
        elif cmd == "/export":
            if not self.cid: self.warn("No active conversation to export."); return True
            fname = arg or f"chat-{self.cid}.md"
            if not fname.endswith((".md", ".txt")): fname += ".md"
            self._export(self.cid, fname)
        elif cmd == "/regen": self._regenerate()
        elif cmd == "/compact": self._compact()
        elif cmd == "/config": self._cmd_config(arg)
        elif cmd == "/clear": print("\033c", end="")
        elif cmd == "/tokens":
            if not self.cid: self.warn("No active conversation."); return True
            msgs = self.db.get_msgs(self.cid)
            total = sum(est_tok(m["content"]) for m in msgs)
            self.info(f"Conversation: ~{total} tokens ({len(msgs)} messages)")
        elif cmd == "/copy":
            if not self.last_reply: self.warn("Nothing to copy yet."); return True
            self.info("Copied to clipboard." if TermuxAPI.copy(self.last_reply) else "termux-api not available.")
        elif cmd == "/paste":
            txt = TermuxAPI.paste()
            if txt is None: self.warn("termux-api not available.")
            elif not txt.strip(): self.warn("Clipboard is empty.")
            else: print(f"  {C.GRAY}clipboard →{C.RESET} {C.ITALIC}{txt[:80]}{'…' if len(txt) > 80 else ''}{C.RESET}"); self.chat(txt.strip())
        elif cmd == "/speak":
            if not self.last_reply: self.warn("Nothing to speak yet."); return True
            if not TermuxAPI.speak(self.last_reply): self.warn("termux-api not available.")
        elif cmd == "/share":
            if not self.last_reply: self.warn("Nothing to share yet."); return True
            if not TermuxAPI.share(self.last_reply): self.warn("termux-api not available.")
        elif cmd == "/server":
            parts = arg.split()
            if not parts: self.warn("Usage: /server start|stop|status [ollama]"); return True
            action = parts[0]
            engine = parts[1] if len(parts) > 1 else "ollama"
            ServerManager.manage(action, engine)
        else: self.warn(f"Unknown command: {cmd}"); self.hint("Type /help for available commands.")
        return True

    def _cmd_profile(self, arg):
        sub = arg.split(maxsplit=1)
        if not sub: self.hint("Usage: /profile add|set|show ..."); return
        if sub[0] == "add" and len(sub) > 1:
            parts = sub[1].split()
            if len(parts) < 3: self.warn("Usage: /profile add <name> <base_url> <model> [api_key]"); return
            name, base_url, model = parts[0], parts[1], parts[2]
            api_key = parts[3] if len(parts) > 3 else ""
            self.cfg.set_path(f"backends.{name}", {"base_url": base_url, "model": model, "api_key": api_key})
            self.info(f"Added profile '{name}'."); self.hint(f"Switch to it: /backend {name}")
        elif sub[0] == "set" and len(sub) > 1:
            bits = sub[1].split(maxsplit=1)
            if len(bits) != 2 or "." not in bits[0]: self.warn("Usage: /profile set <name>.<field> <value>"); return
            key, val = bits[0], parse_value(bits[1])
            self.cfg.set_path(f"backends.{key}", val)
            display = mask(str(val)) if "api_key" in key else val
            self.info(f"Set backends.{key} = {display}")
            if key.split(".")[0] == self.cfg.get("backend"):
                try: self.backend = get_backend(self.cfg)
                except: pass
        elif sub[0] == "show" and len(sub) > 1:
            p = self.cfg.get("backends", {}).get(sub[1])
            if not p: self.err(f"No such profile: {sub[1]}"); return
            shown = dict(p)
            if shown.get("api_key"): shown["api_key"] = mask(shown["api_key"])
            print(json.dumps(shown, indent=2))
        else: self.hint("Usage: /profile add|set|show ...")

    def _cmd_config(self, arg):
        if arg.startswith("set "):
            rest = arg[4:].strip()
            bits = rest.split(maxsplit=1)
            if len(bits) != 2: self.warn("Usage: /config set <key> <value>"); return
            key, val = bits[0], parse_value(bits[1])
            self.cfg.set_path(key, val)
            display = mask(str(val)) if "api_key" in key else val
            self.info(f"Set {key} = {display}")
            try: self.backend = get_backend(self.cfg)
            except: pass
        else: print(json.dumps(self.cfg.masked_dict(), indent=2))

    def _show_status(self):
        name, _ = self.cfg.active_profile()
        api = TermuxAPI.status() if IS_TERMUX else {}
        print(f"\n  {C.BOLD}── Status ──{C.RESET}")
        print(f"  {C.DIM}backend    {C.RESET}{C.GREEN}{name}{C.RESET}")
        print(f"  {C.DIM}model      {C.RESET}{C.GREEN}{self._current_model()}{C.RESET}")
        print(f"  {C.DIM}chat       {C.RESET}{'#'+str(self.cid) if self.cid else 'new'}")
        print(f"  {C.DIM}tools      {C.RESET}{'build' if self.cfg.get('tools_enabled') else 'plan'}")
        print(f"  {C.DIM}multi-line {C.RESET}{'on' if self.multi_line else 'off'}")
        print(f"  {C.DIM}stream     {C.RESET}{'on' if self.cfg.get('stream') else 'off'}")
        print(f"  {C.DIM}temperature{C.RESET} {self.cfg.get('temperature')}")
        print(f"  {C.DIM}max_tokens {C.RESET} {self.cfg.get('max_tokens')}")
        print(f"  {C.DIM}show_tokens{C.RESET} {'on' if self.cfg.get('show_tokens') else 'off'}")
        print(f"  {C.DIM}system     {C.RESET}{C.ITALIC}{self.cfg.system_prompt()[:70]}{C.RESET}")
        if IS_TERMUX:
            parts = [k for k, v in api.items() if v]
            print(f"  {C.DIM}termux-api {C.RESET}{', '.join(parts) if parts else 'not installed'}")
        print()

    def _show_history(self):
        convs = self.db.list_convs()
        if not convs: self.warn("No conversations yet."); return
        print(f"\n  {C.BOLD}{'':3s}{'id':>4s}  {'title':30s} {'msgs':>4s}  {'updated'}{C.RESET}")
        print(f"  {C.DIM}{'─' * 65}{C.RESET}")
        for c in convs:
            mark = f"{C.GREEN}▶{C.RESET}" if c["id"] == self.cid else " "
            title, mc = c["title"][:30], c["msg_count"]
            ts = fmt_time(c["updated_at"])
            print(f"  {mark} {C.CYAN}{c['id']:>4d}{C.RESET}  {title:30s} {mc:>4d}  {C.DIM}{ts}{C.RESET}")
        print()

    def _show_conversation(self, cid, limit=50):
        msgs = self.db.get_msgs(cid, limit=limit)
        if not msgs: self.hint("Conversation is empty."); return
        print(f"\n  {C.DIM}── {len(msgs)} messages ──{C.RESET}\n")
        for m in msgs:
            if m["role"] == "user": print(f"  {C.GREEN}You:{C.RESET} {m['content'][:200]}{'…' if len(m['content']) > 200 else ''}")
            elif m["role"] == "assistant": print(f"  {C.CYAN}AI:{C.RESET}  {m['content'][:200]}{'…' if len(m['content']) > 200 else ''}")
            print()

    def _export(self, cid, fname):
        conv = self.db.get_conv(cid)
        msgs = self.db.get_msgs(cid, limit=10000)
        lines = [f"# {conv['title']}", f"", f"- Backend: {conv['backend']}", f"- Model: {conv['model']}", f"- Exported: {time.strftime('%Y-%m-%d %H:%M')}", ""]
        for m in msgs:
            if m["role"] == "user": lines += ["## You", "", m["content"], ""]
            elif m["role"] == "assistant": lines += ["## AI", "", m["content"], ""]
        try: Path(fname).write_text("\n".join(lines)); self.info(f"Exported to: {fname}")
        except Exception as e: self.err(str(e))

    def _regenerate(self):
        if not self.cid or not self.last_user_msg: self.warn("Nothing to regenerate."); return
        self.db.conn.execute("DELETE FROM messages WHERE conversation_id = ? AND role = 'assistant' AND id = (SELECT MAX(id) FROM messages WHERE conversation_id = ? AND role = 'assistant')", (self.cid, self.cid))
        self.db.conn.commit()
        self.chat(self.last_user_msg)

    def _compact(self):
        if not self.cid: self.warn("No active conversation to compact."); return
        msgs = self.db.get_msgs(self.cid, limit=100)
        if len(msgs) < 4: self.warn("Not enough messages to compact."); return
        self.info("Compacting conversation...")
        transcript = "\n\n".join([f"{m['role']}: {m['content'][:500]}" for m in msgs])
        prompt = f"Summarize the following conversation into a concise context block. Preserve key facts, code snippets, and decisions:\n\n{transcript}"
        try:
            resp = ""
            for t in self.backend.chat([{"role":"user", "content":prompt}], stream=True): resp += t
            self.db.clear_conv_msgs(self.cid)
            self.db.save_msg(self.cid, "assistant", f"[Summary of previous messages]:\n{resp}")
            self.info("Conversation compacted successfully.")
        except Exception as e: self.err(str(e))

    def _read_multi_line(self):
        print(f"  {C.DIM}(multi-line mode — blank line or Ctrl-D to send){C.RESET}")
        lines = []
        try:
            while True:
                line = input(f"  {C.DIM}…{C.RESET} " if lines else self.prompt())
                if not line and lines: break
                lines.append(line)
        except EOFError: pass
        return "\n".join(lines).strip()

    def _read_directory(self, dir_path, dir_name):
        files_content = []
        total_chars, max_files, max_total_chars = 0, 15, 12000
        valid_exts = ('.py', '.js', '.ts', '.tsx', '.jsx', '.java', '.c', '.cpp', '.h', '.cs', '.go', '.rb', '.php', '.swift', '.kt', '.rs', '.txt', '.md', '.csv', '.json', '.xml', '.html', '.css', '.scss', '.sh', '.bash', '.yml', '.yaml', '.toml', '.ini', '.cfg')
        files_scanned, stop_walk = 0, False
        
        for root, dirs, files in os.walk(dir_path):
            if stop_walk: break
            dirs[:] = [d for d in dirs if not d.startswith('.') and d not in ('node_modules', '__pycache__', 'venv', 'env', 'build', 'dist')]
            for f in sorted(files):
                if files_scanned >= max_files or total_chars > max_total_chars: stop_walk = True; break
                if f.startswith('.'): continue
                ext = os.path.splitext(f)[1].lower()
                if ext in valid_exts:
                    file_path = os.path.join(root, f)
                    rel_path = os.path.relpath(file_path, dir_path)
                    content = FileReader.read(file_path)
                    if content and not content.startswith("[Error") and not content.startswith("[Unsupported"):
                        files_scanned += 1
                        snippet = content[:2000]
                        total_chars += len(snippet)
                        files_content.append(f"--- File: {rel_path} ---\n{snippet}")
        if not files_content: return f"[Directory '{dir_name}' scanned, but no readable text/code files found.]"
        return f"[Contents of directory '{dir_name}']:\n" + "\n\n".join(files_content)

    def _extract_files(self, text):
        attached = []
        # Smarter regex: looks for strings with dots or slashes that actually exist on disk
        tokens = re.findall(r'(?:(?:\./|~/|/)?(?:[\w.\-]+/)*[\w.\-]+\.\w{2,5})', text)
        if "this folder" in text.lower() or "current directory" in text.lower() or "this directory" in text.lower():
            tokens.append(".")
            
        for token in tokens:
            if "://" in token: continue
            path_str = token.strip("\"'.,")
            path = os.path.expanduser(path_str)
            if not os.path.exists(path): continue # Strict check: only attach if it exists
                
            if os.path.isfile(path):
                content = FileReader.read(path)
                if content:
                    max_len = 12000
                    snippet = content[:max_len]
                    if len(content) > max_len: snippet += "\n... [truncated]"
                    attached.append(f"[Content of file '{path_str}']:\n{snippet}")
                    self.info(f"Attached file: {C.CYAN}{path_str}{C.RESET}")
            elif os.path.isdir(path):
                dir_content = self._read_directory(path, path_str)
                if dir_content:
                    attached.append(dir_content)
                    self.info(f"Scanned directory: {C.CYAN}{path_str}{C.RESET}")
        if attached: return text + "\n\n" + "\n\n".join(attached)
        return text

    def _build_sys_prompt(self):
        sys_prompt = self.cfg.system_prompt()
        cwd = os.getcwd()
        try:
            files = sorted([f for f in os.listdir(cwd) if not f.startswith('.')])
            tree = ", ".join(files[:30]) if files else "(empty)"
            sys_prompt += f"\n\n[Context] The user is running this in a terminal. Current working directory: {cwd}\nFiles visible here: {tree}"
        except: sys_prompt += f"\n\n[Context] The user is running this in a terminal. Current working directory: {cwd}"
        if self.cfg.get("tools_enabled"): sys_prompt += "\n\n[Tools] You are in BUILD mode. You can read, write, and modify files, and execute any shell commands. Ensure you use exact paths."
        else: sys_prompt += "\n\n[Tools] You are in PLAN mode. You can read files and run safe inspection commands (ls, cat, grep), but you must NOT modify, write, or delete anything. Write attempts will be blocked."
        return sys_prompt

    def chat(self, txt):
        if not self.backend: self.err("No working backend. Use /profile add or /backend to configure one."); return
        txt = self._extract_files(txt)
        name, _ = self.cfg.active_profile()
        if not self.cid: self.cid = self.db.new_conv(title=txt[:50], model=self._current_model(), backend=name)
        self.db.save_msg(self.cid, "user", txt)
        self.last_user_msg = txt
        
        sys_prompt = self._build_sys_prompt()
        msgs = [{"role": "system", "content": sys_prompt}] + self.db.get_msgs(self.cid)

        sys.stdout.write(f"\n  {C.CYAN}AI{C.RESET}  ")
        sys.stdout.flush()
        spinner = Spinner("thinking")
        spinner.start()

        resp, formatter = "", MarkdownFormatter()
        try:
            for event in self.backend.chat_with_tools(msgs):
                if event["type"] == "tool_call":
                    spinner.stop()
                    name, args = event["name"], event["args"]
                    if name == "run_command": print(f"\n  {C.MAGENTA}⚙ AI is running command:{C.RESET} {C.CYAN}{args.get('command', '')}{C.RESET}")
                    elif name == "read_file": print(f"\n  {C.MAGENTA}📄 AI is reading file:{C.RESET} {C.CYAN}{args.get('path', '')}{C.RESET}")
                    elif name == "write_file": print(f"\n  {C.MAGENTA}✍️  AI is writing to file:{C.RESET} {C.CYAN}{args.get('path', '')}{C.RESET}")
                    elif name == "list_files": print(f"\n  {C.MAGENTA}📁 AI is listing files in:{C.RESET} {C.CYAN}{args.get('path', '.')}{C.RESET}")
                    elif name == "search_files": print(f"\n  {C.MAGENTA}🔍 AI is searching for '{args.get('query', '')}' in {args.get('path', '.')}{C.RESET}")
                    spinner = Spinner("executing"); spinner.start()
                elif event["type"] == "tool_result":
                    spinner.stop()
                    print(f"  {C.DIM}└ Done.{C.RESET}\n")
                    spinner = Spinner("thinking"); spinner.start()
                elif event["type"] == "text":
                    spinner.stop()
                    resp += event["content"]
                    formatter.feed(event["content"])
                    formatter.flush()
                    sys.stdout.flush()
        except KeyboardInterrupt:
            spinner.stop(); formatter.flush()
            print(f"\n  {C.YELLOW}[interrupted — partial reply saved]{C.RESET}")
            if resp:
                self.db.save_msg(self.cid, "assistant", resp)
                self.last_reply = resp
                return
        except Exception as e:
            spinner.stop(); formatter.flush()
            print(f"\n  {C.RED}✗ {e}{C.RESET}")
            self.db.conn.execute("DELETE FROM messages WHERE conversation_id = ? AND role = 'user' AND id = (SELECT MAX(id) FROM messages WHERE conversation_id = ? AND role = 'user')", (self.cid, self.cid))
            self.db.conn.commit()
            return

        print()
        if self.cfg.get("show_tokens") and resp: print(f"  {C.DIM}~{est_tok(resp)} tokens{C.RESET}")
        if resp:
            self.db.save_msg(self.cid, "assistant", resp)
            self.last_reply = resp
            if self.cfg.get("tts_replies"): TermuxAPI.speak(resp)

    def run(self):
        self.banner()
        while True:
            try:
                i = self._read_multi_line() if self.multi_line else input(self.prompt()).strip()
                if not i: continue
                if i.startswith("/"): self.run_cmd(i); continue
                self.chat(i)
            except EOFError: print(f"\n  {C.DIM}Bye!{C.RESET}"); break
            except KeyboardInterrupt: print(f"\n  {C.DIM}Ctrl-C again or /exit to quit{C.RESET}")


def main():
    import argparse
    parser = argparse.ArgumentParser(description="Termux AI CLI")
    parser.add_argument("prompt", nargs="*", help="Prompt for the AI")
    parser.add_argument("-c", "--cmd", action="store_true", help="Generate a shell command from prompt")
    parser.add_argument("-j", "--json", action="store_true", help="Output response as JSON")
    parser.add_argument("-m", "--model", help="Override model")
    args = parser.parse_args()

    if args.prompt or args.cmd:
        cfg = Config()
        try: backend = get_backend(cfg)
        except Exception as e: print(f"Error: {e}", file=sys.stderr); sys.exit(1)
        
        prompt_text = " ".join(args.prompt)
        prompt_text = App()._extract_files(prompt_text)
        
        if args.cmd:
            sys_msg = "You are a translation tool that translates natural language descriptions into a single executable Termux/Linux bash command. Return ONLY the raw shell command, with absolutely no markdown code block formatting, no explanation, and no extra text. Just the executable command line."
            payload = prompt_text
        else:
            sys_msg = cfg.system_prompt()
            cwd = os.getcwd()
            try:
                files = sorted([f for f in os.listdir(cwd) if not f.startswith('.')])
                tree = ", ".join(files[:30]) if files else "(empty)"
                sys_msg += f"\n\n[Context] The user is running this in a terminal. Current working directory: {cwd}\nFiles visible here: {tree}"
            except: sys_msg += f"\n\n[Context] The user is running this in a terminal. Current working directory: {cwd}"
            payload = prompt_text

        msgs = [{"role": "system", "content": sys_msg}, {"role": "user", "content": payload}]
        
        try:
            resp = ""
            for t in backend.chat(msgs, stream=True):
                resp += t
            
            if args.cmd:
                cmd_str = resp.strip().replace("```bash", "").replace("```", "").strip()
                if args.json:
                    print(json.dumps({"command": cmd_str}))
                else:
                    print(f"{C.CYAN}Suggested Command:{C.RESET} {C.BOLD}{cmd_str}{C.RESET}")
                    try:
                        confirm = input(f"{C.YELLOW}Run this command? (y/N): {C.RESET}").strip().lower()
                        if confirm in ("y", "yes"):
                            # Safer execution using shell=False for one-shot commands
                            import shlex
                            subprocess.run(shlex.split(cmd_str))
                    except: pass
            else:
                if args.json:
                    print(json.dumps({"response": resp}))
                else:
                    formatter = MarkdownFormatter(indent="")
                    formatter.feed(resp)
                    formatter.flush()
                    print()
        except Exception as e:
            if args.json: print(json.dumps({"error": str(e)}))
            else: print(f"\nError: {e}", file=sys.stderr)
            sys.exit(1)
    else:
        App().run()

if __name__ == "__main__":
    main()
