    def set_path(self, dotted_key, v, save=True):
        parts = dotted_key.split(".")
        node = self.cfg
        for p in parts[:-1]:
            if p not in node or not isinstance(node[p], dict): node[p] = {}
            node = node[p]
        node[parts[-1]] = v
        if save: self.save()

