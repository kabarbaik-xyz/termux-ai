class App:
    COMMANDS = ["/new", "/show", "/history", "/load", "/rename", "/delete", "/regen", "/export", "/compact", "/backends", "/backend", "/model", "/profile", "/system", "/config", "/tools", "/multi", "/tokens", "/status", "/copy", "/paste", "/speak", "/share", "/server", "/clear", "/help", "/exit", "/quit"]

    def __init__(self):
        self.cfg = Config()
        self.db = Database()
        atexit.register(self.db.close) # Ensure DB closes safely
        try: self.backend = get_backend(self.cfg)
        except Exception as e: print(f"{C.RED}Backend error: {e}{C.RESET}"); self.backend = None
        self.cid = None
        self.last_reply = ""
        self.last_user_msg = ""
        self.multi_line = self.cfg.get("multi_line", False)
        self._validate_config()
        self.setup_rl()

    def _validate_config(self):
        name, prof = self.cfg.active_profile()
        if not prof: return
        base = prof.get("base_url", "")
        if not base.startswith("http"): self.warn(f"Backend '{name}' URL looks invalid: {base}")
        if "localhost" not in base and "127.0.0.1" not in base and not prof.get("api_key"):
            self.warn(f"Backend '{name}' is remote but has no API key.")

    def setup_rl(self):
        if not HAVE_READLINE: return
        try: readline.read_history_file(str(HIST_FILE))
        except: pass
        readline.set_history_length(1000)
        self._default_completer = readline.get_completer()
        try:
            readline.set_completer_delims(" \t\n")
            readline.set_completer(self._completer)
            readline.parse_and_bind("tab: complete")
        except: pass
        atexit.register(self._save_history)

    def _completer(self, text, state):
        line = readline.get_line_buffer()
        if not line.startswith("/"):
            return self._default_completer(text, state) if self._default_completer else None
        parts = line.split()
        if len(parts) <= 1 and not line.endswith(" "):
            matches = [c + " " for c in self.COMMANDS if c.startswith(text)]
        else:
            cmd = parts[0]
            if cmd in ("/tools", "/multi") and (len(parts) == 1 or (len(parts) == 2 and not line.endswith(" "))):
                matches = [o + " " for o in ["on", "off"] if o.startswith(text)]
            elif cmd == "/profile" and (len(parts) == 1 or (len(parts) == 2 and not line.endswith(" "))):
                matches = [o + " " for o in ["add", "set", "show"] if o.startswith(text)]
            elif cmd in ("/load", "/delete"):
                try:
                    convs = self.db.list_convs(limit=50)
                    matches = [str(c["id"]) + " " for c in convs if str(c["id"]).startswith(text)]
                except: matches = []
            elif cmd == "/backend":
                backends = list(self.cfg.get("backends", {}).keys()) + ["anthropic", "claude"]
                matches = [b + " " for b in backends if b.startswith(text)]
            elif cmd == "/server" and (len(parts) == 1 or (len(parts) == 2 and not line.endswith(" "))):
                matches = [o + " " for o in ["start", "stop", "status"] if o.startswith(text)]
            else: matches = []
        if state < len(matches): return matches[state]
        return None

    def _save_history(self):
        if not HAVE_READLINE: return
        try: CONFIG_DIR.mkdir(parents=True, exist_ok=True); readline.write_history_file(str(HIST_FILE))
        except: pass

    def _current_model(self):
        name, profile = self.cfg.active_profile()
        if name in ("anthropic", "claude"): return (profile or {}).get("model") or "claude-3-5-sonnet-20241022"
        return (profile or {}).get("model", "?")

