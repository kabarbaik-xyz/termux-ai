# Tools & Backends
# ---------------------------------------------------------------------------
class Tools:
    TOOLS = [
        {"type": "function", "function": {"name": "read_file", "description": "Read file contents", "parameters": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}},
        {"type": "function", "function": {"name": "write_file", "description": "Write content to file", "parameters": {"type": "object", "properties": {"path": {"type": "string"}, "content": {"type": "string"}}, "required": ["path", "content"]}}},
        {"type": "function", "function": {"name": "list_files", "description": "List files in directory", "parameters": {"type": "object", "properties": {"path": {"type": "string"}}}}},
        {"type": "function", "function": {"name": "run_command", "description": "Execute a safe shell command and return stdout/stderr", "parameters": {"type": "object", "properties": {"command": {"type": "string"}}, "required": ["command"]}}},
        {"type": "function", "function": {"name": "search_files", "description": "Search text in files (uses grep)", "parameters": {"type": "object", "properties": {"query": {"type": "string"}, "path": {"type": "string"}}, "required": ["query"]}}},
    ]
    PLAN_TOOLS = [t for t in TOOLS if t["function"]["name"] != "write_file"]

    @staticmethod
    def get_schemas(build_mode: bool): return Tools.TOOLS if build_mode else Tools.PLAN_TOOLS

    @staticmethod
    def to_anthropic_schema(build_mode: bool):
        return [{"name": t["function"]["name"], "description": t["function"]["description"], "input_schema": t["function"]["parameters"]} for t in Tools.get_schemas(build_mode)]

    @staticmethod
    def run(name, args, build_mode=False):
        try:
            if name == "read_file":
                p = os.path.expanduser(args.get("path", ""))
                return Path(p).read_text(errors="ignore") if os.path.exists(p) else "Error: Not found"
            elif name == "write_file":
                if not build_mode: return "Error: Write access is disabled in Plan mode."
                p = os.path.expanduser(args.get("path", ""))
                cwd = os.getcwd()
                # Strict security: Prevent path traversal outside cwd
                if not os.path.abspath(p).startswith(cwd):
                    return f"Error: Cannot write files outside current working directory ({cwd})."
                Path(p).parent.mkdir(parents=True, exist_ok=True)
                Path(p).write_text(args.get("content", ""))
                return f"Written to {p}"
            elif name == "list_files":
                p = os.path.expanduser(args.get("path", "."))
                return "\n".join(sorted(e for e in os.listdir(p) if not e.startswith(".")))
            elif name == "run_command":
                cmd_str = args.get("command", "")
                if not build_mode:
                    # Enforce strict read-only rules for shell commands
                    block_patterns = [
                        r'\brm\b', r'\bmv\b', r'\bcp\b', r'\btouch\b', r'\bmkdir\b', r'\bchmod\b', r'\bchown\b', r'\bdd\b', r'\btee\b',
                        r'pip\sinstall', r'\bapt\b', r'\bpkg\b', r'\bnpm\b', r'\byarn\b', r'>', r'>>',
                        r'python3?\s+-c', r'python3?\s+-m', r'\bperl\b', r'\bnode\b', r'\bruby\b', r'\bphp\b', r'bash\s+-c', r'sh\s+-c'
                    ]
                    if any(re.search(p, cmd_str, re.IGNORECASE) for p in block_patterns):
                        return "Error: Plan mode active. Command blocked because it may modify the system or run an interpreter."
                
                # Security: Use shell=False to prevent shell injection
                try:
                    cmd_list = shlex.split(cmd_str)
                    if not cmd_list: return "Error: Empty command."
                    r = subprocess.run(cmd_list, capture_output=True, text=True, timeout=30)
                    return (r.stdout + r.stderr)[:5000]
                except Exception as e:
                    return f"Error executing command: {e}"
            elif name == "search_files":
                path = args.get("path", ".")
                r = subprocess.run(["grep", "-rn", args.get("query", ""), path], capture_output=True, text=True, timeout=15)
                return "\n".join(r.stdout.splitlines()[:20]) or "No matches"
            return "Unknown tool"
        except Exception as e: return f"Error: {e}"


class Backend:
    def __init__(self, cfg): self.c = cfg
    def _req(self, url, data, headers, timeout=120):
        r = urllib.request.Request(url, data=json.dumps(data).encode(), headers=headers, method="POST")
        try: return urllib.request.urlopen(r, timeout=timeout)
        except urllib.error.HTTPError as e:
            body = ""
            try: body = e.read().decode()[:300]
            except: pass
            raise Exception(f"HTTP {e.code}: {body}")
        except urllib.error.URLError as e: raise Exception(f"Connection failed: {e.reason}")

    def _sse_lines(self, resp):
        buf = b""
        while True:
            chunk = resp.read(4096)
            if not chunk: break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                line = line.decode("utf-8", "replace").strip()
                if line.startswith("data: "):
                    d = line[6:]
                    if d == "[DONE]": return
                    try: yield json.loads(d)
                    except: pass

class OpenAICompatible(Backend):
    def __init__(self, cfg, profile_name, profile):
        super().__init__(cfg)
        self.name = profile_name
        self.profile = profile or {}

    def _headers(self):
        k = self.profile.get("api_key", "")
        h = {"Content-Type": "application/json", "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"}
        if k: h["Authorization"] = f"Bearer {k}"
        return h

    def _url(self):
        base = (self.profile.get("base_url") or "").rstrip("/")
        if not base: raise Exception(f"Profile '{self.name}' has no base_url.\n  Fix: /profile set {self.name}.base_url <url>")
        return f"{base}/chat/completions"

    def _model(self):
        m = self.profile.get("model")
        if not m: raise Exception(f"Profile '{self.name}' has no model set.\n  Fix: /profile set {self.name}.model <name>")
        return m

    def _check_api_key(self):
        base = self.profile.get("base_url", "")
        if not self.profile.get("api_key") and "localhost" not in base and "127.0.0.1" not in base:
            raise Exception(f"Profile '{self.name}' has no api_key set.\n  Fix: /profile set {self.name}.api_key YOUR_KEY")

    def chat(self, msgs, stream=True):
        self._check_api_key()
        d = {"model": self._model(), "messages": msgs, "temperature": self.c.get("temperature"), "stream": stream}
        h = self._headers()
        if stream:
            for chunk in self._sse_lines(self._req(self._url(), d, h)):
                choices = chunk.get("choices") or [{}]
                if t := choices[0].get("delta", {}).get("content", ""): yield t
        else: yield json.loads(self._req(self._url(), d, h).read())["choices"][0]["message"]["content"]

    def chat_with_tools(self, msgs):
        self._check_api_key()
        h = self._headers()
        build_mode = self.c.get("tools_enabled", False)
        for _ in range(5):
            d = {"model": self._model(), "messages": msgs, "temperature": self.c.get("temperature"), "stream": False, "tools": Tools.get_schemas(build_mode)}
            obj = json.loads(self._req(self._url(), d, h).read())
            msg = obj["choices"][0]["message"]
            calls = msg.get("tool_calls") or []
            if not calls:
                yield {"type": "text", "content": msg.get("content", "") or ""}
                return
            msgs.append(msg)
            for call in calls:
                fn = call["function"]
                try: args = json.loads(fn.get("arguments") or "{}")
                except: args = {}
                yield {"type": "tool_call", "name": fn["name"], "args": args}
                result = Tools.run(fn["name"], args, build_mode)
                yield {"type": "tool_result", "name": fn["name"], "result": result}
                msgs.append({"role": "tool", "tool_call_id": call["id"], "content": result})
        yield {"type": "text", "content": "(stopped after 5 tool iterations)"}

class AnthropicBackend(Backend):
    def __init__(self, cfg):
        super().__init__(cfg)
        self.profile = cfg.get("backends", {}).get("anthropic", {})

    def _headers(self):
        k = self.profile.get("api_key") or self.c.get("api_keys", {}).get("anthropic", "")
        if not k: raise Exception("Anthropic key missing.\n  Fix: /profile set anthropic.api_key KEY")
        return {"Content-Type": "application/json", "x-api-key": k, "anthropic-version": "2023-06-01"}

    def _model(self): return self.profile.get("model") or "claude-3-5-sonnet-20241022"

    @staticmethod
    def _split_system(msgs):
        sys_prompt, payload = "", []
        for m in msgs:
            if m["role"] == "system": sys_prompt = m["content"]
            else: payload.append(m)
        return sys_prompt, payload

    def chat(self, msgs, stream=True):
        sys_prompt, payload = self._split_system(msgs)
        d = {"model": self._model(), "messages": payload, "max_tokens": self.c.get("max_tokens", 4096), "stream": stream}
        if sys_prompt: d["system"] = sys_prompt
        h = self._headers()
        url = "https://api.anthropic.com/v1/messages"
        if stream:
            for chunk in self._sse_lines(self._req(url, d, h)):
                if chunk.get("type") == "content_block_delta":
                    if t := chunk.get("delta", {}).get("text", ""): yield t
        else: yield json.loads(self._req(url, d, h).read())["content"][0]["text"]

    def chat_with_tools(self, msgs):
        sys_prompt, payload = self._split_system(msgs)
        h = self._headers()
        url = "https://api.anthropic.com/v1/messages"
        build_mode = self.c.get("tools_enabled", False)
        for _ in range(5):
            d = {"model": self._model(), "messages": payload, "max_tokens": self.c.get("max_tokens", 4096), "tools": Tools.to_anthropic_schema(build_mode)}
            if sys_prompt: d["system"] = sys_prompt
            obj = json.loads(self._req(url, d, h).read())
            blocks = obj.get("content", [])
            tool_uses = [b for b in blocks if b.get("type") == "tool_use"]
            if not tool_uses:
                yield {"type": "text", "content": "".join(b.get("text", "") for b in blocks if b.get("type") == "text")}
                return
            payload.append({"role": "assistant", "content": blocks})
            results = []
            for tu in tool_uses:
                args = tu.get("input", {}) or {}
                yield {"type": "tool_call", "name": tu["name"], "args": args}
                result = Tools.run(tu["name"], args, build_mode)
                yield {"type": "tool_result", "name": tu["name"], "result": result}
                results.append({"type": "tool_result", "tool_use_id": tu["id"], "content": result})
            payload.append({"role": "user", "content": results})
        yield {"type": "text", "content": "(stopped after 5 tool iterations)"}

def get_backend(cfg):
    name, profile = cfg.active_profile()
    if name in ("anthropic", "claude"): return AnthropicBackend(cfg)
    if profile is None:
        available = ", ".join(cfg.get("backends", {}).keys()) or "(none)"
        raise Exception(f"Backend '{name}' not found in config.backends.\n  Available: {available}\n  Fix: /profile add {name} <base_url> <model> [api_key]")
    return OpenAICompatible(cfg, name, profile)


