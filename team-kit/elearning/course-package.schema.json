{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kbti.cloud/schema/course-package/schema.json",
  "title": "kbti-elearning course package",
  "description": "Authoritative shape of a course package (course.json). Single source of truth: mirror in the termux-ai kit at team-kit/elearning/course-package.schema.json. Keep both copies in sync.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title", "language", "audience", "lessons"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "minLength": 2},
    "title": {"type": "string", "minLength": 1},
    "field": {"type": "string"},
    "language": {"type": "string", "minLength": 2},
    "summary": {"type": "string"},
    "source_brief": {"type": "string", "description": "Original project name the course was packaged from"},
    "cover": {
      "type": "object",
      "properties": {
        "file": {"type": "string"},
        "accent": {"type": "string"}
      }
    },
    "audience": {
      "type": "object",
      "required": ["roles"],
      "properties": {
        "roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "routine": {"type": "string"},
        "background": {"type": "string"}
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "file"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "file": {"type": "string", "description": "Path relative to the course dir, e.g. lessons/lesson-01.md"},
          "type": {"enum": ["reading", "story", "drill", "roleplay", "reflection", "case", "assessment", "video", "other"], "default": "reading"},
          "duration_min": {"type": "integer", "minimum": 1},
          "quiz": {
            "type": "object",
            "properties": {
              "questions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["q", "options", "answer"],
                  "properties": {
                    "q": {"type": "string", "minLength": 1},
                    "options": {"type": "array", "minItems": 2, "items": {"type": "string"}},
                    "answer": {"type": "integer", "minimum": 0},
                    "explain": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}